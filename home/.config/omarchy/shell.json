{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "alex.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            {
              "name": "Bucharest",
              "zone": "Europe/Bucharest"
            },
            {
              "name": "Delhi",
              "zone": "Asia/Kolkata"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            }
          ]
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "davefano.trackpad-plus"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": [
        {
          "id": "superwhisper.panel"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "org.gnome.Nautilus",
      "chromium",
      "foot",
      "omacalc",
      "omawrite",
      "X",
      "YouTube"
    ]
  },
  "plugins": [
    {
      "id": "alex.emojis"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.emojis"
  ],
  "cloneSourceRestores": [
    "alex.menu",
    "alex.emojis"
  ]
}
